# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Anthropic (synthesis + email drafting)
ANTHROPIC_API_KEY=your-anthropic-key-here

# Postgres. Railway auto-injects this in prod. For local testing, paste a local
# or Railway Postgres connection string.
DATABASE_URL=postgres://user:pass@host:5432/dbname

# Published Google Sheet CRM (File -> Share -> Publish to web -> CSV)
CRM_CSV_URL=https://docs.google.com/spreadsheets/d/e/EXAMPLE/pub?gid=0&single=true&output=csv

# SEC EDGAR requires a User-Agent with contact info or it 403s.
SEC_USER_AGENT=HT Highlighter you@example.com
